{
  "extends": ["config:js-app", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Only npm devDependencies merge themselves (minor and patch); never Actions or runtime packages",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@zip.js/zip.js"],
      "enabled": false
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["svelte"],
      "allowedVersions": "<5.0.0"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@sveltejs/vite-plugin-svelte"],
      "allowedVersions": "<4.0.0"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["svelte-meta-tags"],
      "allowedVersions": "<4.0.0"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["svelte-gestures"],
      "allowedVersions": "<5.1.0"
    }
  ]
}
