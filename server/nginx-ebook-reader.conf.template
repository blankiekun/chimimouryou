# Upstream's apps/web/nginx/conf.d/default.conf plus the Calibre library, accounts
# and the helper services. A template: render-nginx.sh fills in the ${...} settings
# when the web container starts, and the result goes in conf.d.
# Server-level extras (TLS, resolver, real_ip) come from /etc/nginx/ebook-reader.d/.
#
# Who may do what (checked by the account service through auth_request):
# - reading the library, catalog and shared sync folder needs an account, a
#   trusted network, or PUBLIC_READS=1;
# - signed-out readers on a trusted network write the shared sync folder;
#   elsewhere that needs an account;
# - adding books to Calibre, starting difficulty jobs and editing series or book details need an
#   admin or that permission (Settings → Account → Manage accounts).
# Slows password guessing on top of the account service's own lockouts.
limit_req_zone $binary_remote_addr zone=account_login:1m rate=10r/m;
# Keeps book page searches on Jiten small (its API terms: personal, small scale).
limit_req_zone $binary_remote_addr zone=jiten:1m rate=20r/m;
# Readings files are asked for on each book open; this bounds what one address can queue.
limit_req_zone $binary_remote_addr zone=readings:1m rate=6r/m;

# Behind a reverse proxy every client looks like the proxy, so set
# real_ip_header/set_real_ip_from for it (REAL_IP_FROM in Docker) first.
geo $trusted_address {
  default 0;
${TRUSTED_NETWORKS_GEO}
}

# Only for a Host this server answers to: under DNS rebinding another site's page reaches it
# from the reader's own (trusted) address with its own name as Host. IP literals, localhost and
# SERVER_NAMES are known; any other name needs an account.
map $host $known_host {
  default 0;
  ~^[0-9.]+$ 1;
  ~^\[[0-9a-f:.]+\]$ 1;
  localhost 1;
${SERVER_NAMES_MAP}
}

map "$trusted_address:$known_host" $trusted_network {
  default 0;
  "1:1" 1;
}

# Keep the scheme a TLS-terminating proxy in front of this server reports, so
# the account service's HTTPS check works behind one. Only that proxy
# (REAL_IP_FROM, by the address it connects from) may say so; anyone else's
# X-Forwarded-Proto is ignored.
geo $realip_remote_addr $from_proxy {
  default 0;
${REAL_IP_FROM_GEO}
}

map "$from_proxy:$http_x_forwarded_proto" $forwarded_proto {
  default $scheme;
  "1:https" https;
}

# Service addresses as variables: nginx then starts even when an optional service
# (import, difficulty) isn't running, and resolves Docker names at request time.
map $host $account_upstream { default ${ACCOUNT_UPSTREAM}; }
map $host $api_upstream { default ${API_UPSTREAM}; }
map $host $import_upstream { default ${IMPORT_UPSTREAM}; }
map $host $difficulty_upstream { default ${DIFFICULTY_UPSTREAM}; }
map $host $mokuro_upstream { default ${MOKURO_UPSTREAM}; }
map $host $public_reads { default ${PUBLIC_READS}; }
# A full cover sent for a thumbnail not made yet is revalidated, so the thumbnail replaces it.
map $request_uri $cover_expires {
  default 1d;
  ~^/calibre/thumbs/ epoch;
}

# Server connect (CORS_ORIGINS): the standalone app's origins, echoed back by the
# reader's locations; anyone else gets no Access-Control-Allow-Origin.
map $http_origin $cors_origin {
  default "";
${CORS_ORIGIN_MAP}
}

# HSTS only when the page itself is HTTPS (an empty value sends no header).
map $forwarded_proto $hsts {
  default "";
  https "max-age=31536000";
}

# Cross-origin isolation for the visual novel player only (/v and its frames under /vn/):
# VNBox plays sound through an AudioWorklet fed from a SharedArrayBuffer there. credentialless,
# so cross-origin images (covers) keep loading. Empty elsewhere (no header).
map $uri $vn_coop {
  default "";
  ~^/v(\.html)?$ same-origin;
  ~^/vn/ same-origin;
}
map $uri $vn_coep {
  default "";
  ~^/v(\.html)?$ credentialless;
  ~^/vn/ credentialless;
}

server_tokens off;

server {
  listen 80;
  server_name _;

  include /etc/nginx/ebook-reader.d/*.conf;

  root ${WEB_ROOT};

  # Security headers. nginx drops these in any location with its own add_header,
  # so the locations below with their own repeat them.
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
  add_header Strict-Transport-Security $hsts always;
  add_header Cross-Origin-Opener-Policy $vn_coop always;
  add_header Cross-Origin-Embedder-Policy $vn_coep always;

  gzip on;
  gzip_types application/json text/css application/javascript application/wasm;

  location / {
    try_files $uri $uri.html $uri/ =404;
  }

  # The visual novel engine: one installed from the admin panel wins over the built-in one.
  # Revalidated every time, so browsers pick up a new one.
  location ~ ^/vn/(conscripter\.js|conscripter\.wasm|conscripter-version\.txt)$ {
    root ${ENGINE_DIR};
    try_files /$1 @built_in_engine;
    expires -1;
  }

  location @built_in_engine {
    expires -1;
  }

  # Module scripts (Whisper's ONNX runtime); nginx's mime.types has no .mjs.
  location ~ \.mjs$ {
    types { }
    default_type application/javascript;
  }

  # Theme guide (themes.md in the repository root, copied by the build).
  location = /themes.md {
    default_type text/plain;
    charset utf-8;
    expires -1;
  }

  # Difficulty estimates (chimi-difficulty), computed only when started from the library.
  location = /calibre/difficulty.json {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_shared;
    alias ${DIFFICULTY_FILE};
    expires -1;
  }

  location /calibre/difficulty/api/ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_difficulty_writes;
    auth_request_set $account_admin $upstream_http_x_account_admin;
    rewrite ^/calibre/difficulty/api/(.*)$ /$1 break;
    proxy_pass http://$difficulty_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    # The service checks admin itself too for the frequency list (never the client's header).
    proxy_set_header X-Account-Admin $account_admin;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # Replacing the frequency list (jiten_freq_global.zip, about 8 MB) changes every estimate: admins only.
  location = /calibre/difficulty/api/dictionary {
    auth_request /_account_admin;
    auth_request_set $account_admin $upstream_http_x_account_admin;
    proxy_pass http://$difficulty_upstream/dictionary$is_args$args;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Account-Admin $account_admin;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 300s;
    client_max_body_size 64m;
  }

  # Term dictionaries (Yomitan zips, up to 256 MB) change word lists and readings files: admins only.
  location ~ ^/calibre/difficulty/api/terms(/remove)?$ {
    auth_request /_account_admin;
    auth_request_set $account_admin $upstream_http_x_account_admin;
    rewrite ^/calibre/difficulty/api/(.*)$ /$1 break;
    proxy_pass http://$difficulty_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Account-Admin $account_admin;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    client_max_body_size 256m;
  }

  # Readings files (furigana in context): requested and fetched by every reader who may use the
  # shared sync folder, not only those with the difficulty permission.
  location ~ ^/calibre/difficulty/api/readings/-?[0-9]+$ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_shared;
    limit_req zone=readings burst=10 nodelay;
    limit_req_status 429;
    rewrite ^/calibre/difficulty/api/(.*)$ /$1 break;
    proxy_pass http://$difficulty_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # Ranks of a reader's Anki words and marks (words known): read-only, for every reader of the shared folder.
  location = /calibre/difficulty/api/ranks {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_shared;
    limit_req zone=readings burst=10 nodelay;
    limit_req_status 429;
    client_max_body_size 1m;
    proxy_pass http://$difficulty_upstream/ranks;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # Text of manga pages (mokuro service), by catalog id.
  location ~ ^/calibre/mokuro/(-?[0-9]+\.json)$ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_shared;
    alias ${MOKURO_DIR}/$1;
    expires -1;
  }

  # Making it (or uploading .mokuro files) needs the import permission.
  location /calibre/mokuro/api/ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_import;
    rewrite ^/calibre/mokuro/api/(.*)$ /$1 break;
    proxy_pass http://$mokuro_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 64m;
  }

  # Adding books to the Calibre library (import service).
  location /calibre/import/api/ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_import;
    auth_request_set $account_id $upstream_http_x_account_id;
    auth_request_set $account_admin $upstream_http_x_account_admin;
    rewrite ^/calibre/import/api/(.*)$ /$1 break;
    proxy_pass http://$import_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Account-Id $account_id;
    proxy_set_header X-Account-Admin $account_admin;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 300s;
    # Books up to 300 MB; ZIPs of ONScripter games up to 8 GB (the service checks).
    # Streamed to the service rather than buffered here.
    client_max_body_size 8g;
    proxy_request_buffering off;
  }

  # Admin panel → Tools → Catalog: a full catalog rebuild, so admins only.
  location = /calibre/import/api/catalog {
    auth_request /_account_admin;
    auth_request_set $account_id $upstream_http_x_account_id;
    auth_request_set $account_admin $upstream_http_x_account_admin;
    proxy_pass http://$import_upstream/catalog;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Account-Id $account_id;
    proxy_set_header X-Account-Admin $account_admin;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 1800s;
    client_max_body_size 16k;
  }

  # Admin panel → Tools → Series: rewrites series in metadata.db, so admins only.
  location = /calibre/import/api/series {
    auth_request /_account_admin;
    auth_request_set $account_id $upstream_http_x_account_id;
    auth_request_set $account_admin $upstream_http_x_account_admin;
    proxy_pass http://$import_upstream/series;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Account-Id $account_id;
    proxy_set_header X-Account-Admin $account_admin;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 600s;
    client_max_body_size 16k;
  }

  # Library → Delete: removes books from metadata.db and game folders, so admins only.
  location = /calibre/import/api/remove {
    auth_request /_account_admin;
    auth_request_set $account_id $upstream_http_x_account_id;
    auth_request_set $account_admin $upstream_http_x_account_admin;
    proxy_pass http://$import_upstream/remove;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Account-Id $account_id;
    proxy_set_header X-Account-Admin $account_admin;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 600s;
    client_max_body_size 64k;
  }

  # Accounts. The service checks HTTPS, Origin and Host ($http_host keeps the port,
  # which the browser's Origin has on non-standard ports).
  location /account/api/ {
${CORS_WITH_SECURITY_HEADERS}
    rewrite ^/account/api/(.*)$ /$1 break;
    proxy_pass http://$account_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 16k;
  }

  # Server connect: tokens for the standalone app, rate-limited like sign-in.
  location = /account/api/token {
${CORS_WITH_SECURITY_HEADERS}
    limit_req zone=account_login burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://$account_upstream/token;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 16k;
  }

  location = /account/api/login {
    limit_req zone=account_login burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://$account_upstream/login;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 16k;
  }

  # auth_request checks. The subrequest is checked against its own body limit
  # (default 1m) although the body isn't passed; the protected location sets the
  # real limit, hence client_max_body_size 0.
  location = /_account_auth {
    internal;
    proxy_set_header Host $http_host;
    proxy_pass http://$account_upstream/auth;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-Method $request_method;
    client_max_body_size 0;
  }

  location = /_account_admin {
    internal;
    proxy_set_header Host $http_host;
    proxy_pass http://$account_upstream/auth/admin;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    client_max_body_size 0;
  }

  location = /_account_series {
    internal;
    proxy_set_header Host $http_host;
    proxy_pass http://$account_upstream/auth/series;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    client_max_body_size 0;
  }

  location = /_account_import {
    internal;
    proxy_set_header Host $http_host;
    proxy_pass http://$account_upstream/auth/import;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    client_max_body_size 0;
  }

  # Reads need an account, a trusted network or public reads; writes need an
  # account or a trusted network.
  location = /_account_shared {
    internal;
    proxy_set_header Host $http_host;
    proxy_pass http://$account_upstream/auth/shared/writes;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    # The account service refuses some writes by path (shared_write_allowed).
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Destination $http_destination;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Trusted-Network $trusted_network;
    proxy_set_header X-Public-Reads $public_reads;
    client_max_body_size 0;
  }

  # Reads as above; writes need the permission.
  location = /_account_series_writes {
    internal;
    proxy_set_header Host $http_host;
    proxy_pass http://$account_upstream/auth/series/writes;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Trusted-Network $trusted_network;
    proxy_set_header X-Public-Reads $public_reads;
    client_max_body_size 0;
  }

  location = /_account_difficulty_writes {
    internal;
    proxy_set_header Host $http_host;
    proxy_pass http://$account_upstream/auth/difficulty/writes;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Trusted-Network $trusted_network;
    proxy_set_header X-Public-Reads $public_reads;
    client_max_body_size 0;
  }

  # Book files and covers only; everything else in the library (metadata.db etc.) is hidden.
  location ~ ^/calibre/library/(.+\.(?:epub|htmlz|txt|cbz|zip)|.+/cover\.jpg)$ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_shared;
    alias ${LIBRARY_DIR}/$1;
    types { application/epub+zip epub; application/zip htmlz; text/plain txt; application/zip cbz zip; image/jpeg jpg; }
    charset off;
    expires $cover_expires;
  }

  # Library cards' covers: the catalog builder's thumbnails (JPEG, whatever the name),
  # else the full cover from the library or the visual novel folder.
  location ~ ^/calibre/thumbs/(library/.+/cover\.jpg|vn/.+)$ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_shared;
    root ${THUMB_DIR};
    try_files /$1 /calibre/$1;
    types { }
    default_type image/jpeg;
    expires 1d;
  }

  # Visual novels (VN_PATH): one unpacked ONScripter game per folder, read file by file
  # by the player, which lists folders through the JSON directory listings.
  location /calibre/vn/ {
${CORS}
    auth_request /_account_shared;
    alias ${VN_DIR}/;
    autoindex on;
    autoindex_format json;
    # Game files are data for the player, never pages: no HTML/SVG on this origin.
    types { image/jpeg jpg jpeg; image/png png; image/webp webp; }
    default_type application/octet-stream;
    charset off;
    expires $cover_expires;
    add_header Content-Security-Policy "sandbox; default-src 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Strict-Transport-Security $hsts always;
  }

  # Book page → Find details → Jiten. Its API only answers jiten.moe's own
  # origin, so searches go through here, without the reader's cookies. Any
  # signed-in reader: a pick also sets a Windows game's length (its Jiten deck,
  # found by VNDB id), which is the reader's own. Read-only GETs, three paths.
  location ~ ^/jiten/(?<jiten_path>search|api/media-deck/(?:by-link-id/2/v[0-9]+|[0-9]+/detail))$ {
    auth_request /_account_auth;
    limit_except GET { deny all; }
    limit_req zone=jiten burst=5 nodelay;
    set $jiten_host api.jiten.moe;
    if ($jiten_path = search) {
      set $jiten_path api/media-deck/get-media-decks;
    }
    proxy_pass https://$jiten_host/$jiten_path$is_args$args;
    proxy_ssl_server_name on;
    proxy_set_header Host $jiten_host;
    proxy_set_header Cookie "";
    proxy_set_header Origin "";
    proxy_set_header Referer "";
    proxy_hide_header Set-Cookie;
    proxy_read_timeout 20s;
  }

  # Audiobookshelf plugin (AUDIOBOOKSHELF_URL; render-nginx.sh writes the block).
${AUDIOBOOKSHELF_LOCATION}

  # The v1 API (server/api): catalog, search and reading data. Signed out on a trusted
  # network, rows go to the shared account ''.
  location /api/v1/ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_shared;
    auth_request_set $account_id $upstream_http_x_account_id;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    # Empty (signed out) drops the header: the client's own never reaches the service.
    proxy_set_header X-Account-Id $account_id;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 32m;
  }

  # Series, book details and covers apply to everyone: writes need the series permission.
  location ~ ^/api/v1/(series|metadata)/|^/api/v1/books/[0-9]+/cover$ {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_series_writes;
    auth_request_set $account_id $upstream_http_x_account_id;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    # Empty (signed out) drops the header: the client's own never reaches the service.
    proxy_set_header X-Account-Id $account_id;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 10m;
  }

  # Admin panel → Tools → Catalog: the migration report (old sync folders that matched no book).
  location = /api/v1/migration {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_admin;
    auth_request_set $account_id $upstream_http_x_account_id;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    proxy_set_header X-Account-Id $account_id;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 16k;
  }

  # Windows game records: signed-in accounts only.
  location ~ ^/api/v1/games(/|$) {
${CORS_WITH_SECURITY_HEADERS}
    auth_request /_account_auth;
    auth_request_set $account_id $upstream_http_x_account_id;
    proxy_pass http://$api_upstream;
    proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
    # Empty (signed out) drops the header: the client's own never reaches the service.
    proxy_set_header X-Account-Id $account_id;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    client_max_body_size 100m;
  }

  location /calibre/ {
    return 404;
  }

  error_page 404 /404.html;
  # Only the site's own 404 page: sync or game files named 404.html stay reachable.
  location ~ ^/404(\.html)?$ {
    internal;
    # A missing sync file is an ordinary answer to the standalone app (server connect): without
    # these, its 404 would arrive as a CORS failure.
${CORS_WITH_SECURITY_HEADERS}
  }
}
