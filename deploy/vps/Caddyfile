# The standalone site on a VPS behind Cloudflare's proxy (deploy/vps/README.md).
# Install as /etc/caddy/Caddyfile. .github/workflows/vps-site.yml uploads each build into
# /srv/chimireader/releases/<id>/ and points /srv/chimireader/current at it.
chimireader.blankie.moe {
	# Cloudflare (SSL mode Full (strict)) connects with this Cloudflare Origin CA certificate;
	# readers only ever see Cloudflare's. No ACME, so nothing to issue through the proxy.
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	root * /srv/chimireader/current
	encode zstd gzip

	# The same as the Docker image's nginx.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Hashed file names: kept for a year. VNBox, its root fs and JMdict keep their names across
	# versions, so Cloudflare keeps them a day (purge /vn/vnbox/ after a VNBox bump) and browsers
	# revalidate: a stale boxedwine.wasm next to a new boxedwine.js fails with ASM_CONSTS errors.
	# Everything else (pages, service worker, _app/version.json, manifests) is revalidated.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@big path /vn/vnbox/* /dictionaries/*
	header @big Cache-Control "public, max-age=0, must-revalidate, s-maxage=86400"
	@other not path /_app/immutable/* /vn/vnbox/* /dictionaries/*
	header @other Cache-Control no-cache

	@themes path /themes.md
	header @themes Content-Type "text/plain; charset=utf-8"

	# Cross-origin isolation for the Windows game player only: OFF. The owner approved it for the
	# VN player alone (2026-10-26), for AudioWorklet and threads (SharedArrayBuffer). Turning it on
	# changes VNBox's audio and lazy-fs paths, so it is its own step with its own testing. VNBox runs
	# in /v (the VN reader) and its frame /vn/vnbox.html (with /vn/vnbox/*): both documents need the
	# headers, and /v only gets them on a full page load (the app reaches /v by client-side
	# navigation, which keeps the previous page's headers, so that needs a reload link too).
	# credentialless rather than require-corp, so cross-origin images (covers) keep loading.
	# @isolated path /v /v.html /vn/*
	# header @isolated {
	# 	Cross-Origin-Opener-Policy same-origin
	# 	Cross-Origin-Embedder-Policy credentialless
	# }

	# Book page → Find details → Jiten (searches, and a Windows game's length by its VNDB id), as
	# the Docker image's nginx does: Jiten's API only answers jiten.moe's own origin. Read-only GETs
	# on three paths, rate-limited (the caddy-ratelimit module, see README.md), without the reader's
	# cookies or address. Keyed by CF-Connecting-IP (every request comes through Cloudflare), plus
	# a cap for everyone together: Jiten's API is for small-scale use.
	@jiten {
		method GET
		path_regexp jiten ^/jiten/(search|api/media-deck/(by-link-id/2/v[0-9]+|[0-9]+/detail))$
	}
	# route: in this order (rate_limit has no place in Caddy's standard directive order).
	handle @jiten {
		route {
			rate_limit {
				zone jiten_reader {
					key {http.request.header.CF-Connecting-IP}
					events 20
					window 1m
				}
				zone jiten_all {
					key static
					events 200
					window 1m
				}
			}
			rewrite /jiten/search /api/media-deck/get-media-decks?{query}
			uri strip_prefix /jiten
			reverse_proxy https://api.jiten.moe {
				header_up Host api.jiten.moe
				header_up -Cookie
				header_up -Origin
				header_up -Referer
				header_up -X-Forwarded-For
				header_up -Cf-Connecting-Ip
				header_up -True-Client-Ip
				header_up -Cf-Ipcountry
				header_down -Set-Cookie
			}
		}
	}

	# Like GitHub Pages: prerendered pages by path (/settings → settings.html), else the SPA
	# fallback (adapter-static's 404.html), served as 200 so the app can route it. In a handle so
	# that it never sees /jiten/ paths (try_files runs before route in Caddy's standard order).
	handle {
		try_files {path} {path}.html {path}/index.html /404.html
		file_server
	}
}

# blankiekun.github.io's site, deployed by its own vps-site.yml with the second deploy key
# (CHIMIREADER_SITE=/srv/blankie). Same Origin CA certificate (blankie.moe and *.blankie.moe).
blankie.moe {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	root * /srv/blankie/current
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# VNBox keeps its file names across versions: Cloudflare a day (purge /vnbox/ after a bump),
	# browsers revalidate so the .js and .wasm stay a pair. The rest of
	# the site has unhashed names, so it is revalidated.
	@big path /vnbox/*
	header @big Cache-Control "public, max-age=0, must-revalidate, s-maxage=86400"
	@other not path /vnbox/*
	header @other Cache-Control no-cache

	# Like GitHub Pages: /sites/help → sites/help.html.
	try_files {path} {path}.html {path}/index.html
	file_server
}
