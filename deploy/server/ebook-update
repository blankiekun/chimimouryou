#!/bin/bash
# Updates a stack installed by scripts/deploy.sh to a commit of the GitHub
# repository, when an admin asks for it in the admin panel (Tools → Updates).
#
#   ebook-update install   installs the systemd units (deploy.sh runs it)
#   ebook-update           handles a waiting request (run by ebook-update.service)
#
# The account service writes DATA_PATH/state/update/request.json; the path unit
# starts this, which downloads the commit (main's head or the latest release), swaps it into /opt/ebook-reader,
# builds the images and restarts the stack like deploy.sh. If the build or restart fails
# the previous version is put back. Progress goes to status.json (engine-status.json for engines) for the admin panel.
# A request naming an "engine" (Tools → Visual novel engine) instead downloads that
# CONscripter release's web build into DATA_PATH/state/engine, which nginx serves ahead of
# the built-in engine: nothing is built or restarted.
# DATA_PATH (absolute) and UPDATE_REPO come from /etc/ebook-reader/env.
set -euo pipefail

APP=/opt/ebook-reader
CONFIG=/etc/ebook-reader
COMMANDS="ebook-compose ebook-account ebook-update"

setting() { sed -n "s/^$1=//p" "$CONFIG/env" | tail -n 1 | tr -d '"'"'"; }

data=$(setting DATA_PATH)
repo=$(setting UPDATE_REPO)
repo=${repo:-blankiekun/chimimouryou}
case "$data" in
  /*) ;;
  *) echo "ebook-update needs an absolute DATA_PATH in $CONFIG/env" >&2; exit 1 ;;
esac
if ! [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  echo "UPDATE_REPO must look like owner/repository" >&2
  exit 1
fi
dir=$data/state/update
# The folder belongs to the containers' user: touch it only as that user, so a
# link planted there can't turn root's writes into writes elsewhere.
read -r uid gid < <(stat -c '%u %g' "$dir")
as_owner() { setpriv --reuid="$uid" --regid="$gid" --clear-groups "$@"; }
# write <file>: stdin to <file>, replacing it.
write() { as_owner sh -c 'rm -f "$1.tmp" && cat > "$1.tmp" && mv "$1.tmp" "$1"' sh "$1"; }

if [ "${1:-}" = install ]; then
  cat > /etc/systemd/system/ebook-update.service <<EOF
[Unit]
Description=ebook-reader update requested in the admin panel

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ebook-update
EOF
  cat > /etc/systemd/system/ebook-update.path <<EOF
[Unit]
Description=Watch for ebook-reader update requests

[Path]
PathExists=$dir/request.json

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable ebook-update.path >/dev/null 2>&1
  systemctl restart ebook-update.path
  # The admin panel only offers updates when this marker exists.
  printf '%s\n' "$repo" | write "$dir/updater"
  exit 0
fi

[ -f "$dir/request.json" ] || exit 0
ref=$(as_owner sed -n 's/.*"ref": *"\([0-9a-f]\{7,40\}\)".*/\1/p' "$dir/request.json")
engine=$(as_owner sed -n 's/.*"engine": *"\([A-Za-z0-9._-]\{1,64\}\)".*/\1/p' "$dir/request.json")
ref=${engine:-$ref}
as_owner rm -f "$dir/request.json"
# Engine installs report apart, so neither hides the last app update's result.
status_file=status.json
[ -z "$engine" ] || status_file=engine-status.json

# Messages are fixed strings (no quotes), so this stays valid JSON.
status() {
  printf '{"state": "%s", "ref": "%s", "at": %s, "message": "%s"}\n' \
    "$1" "$ref" "$(date +%s)" "$2" | write "$dir/$status_file"
}

if [ -z "$ref" ]; then
  status failed "The request did not name a commit or an engine release"
  exit 0
fi

# Beside $APP, so moving the new source into place is a rename on the same file system.
work=$(mktemp -d "$APP.new.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'status failed "Update failed; see journalctl -u ebook-update on the server"' ERR

compose=/usr/local/bin/ebook-compose
status running "Downloading"
if [ -n "$engine" ]; then
  # Only the latest release, as for the app below.
  latest=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/blankiekun/CONscripter/releases/latest | sed 's|.*/tag/||')
  if [ "$latest" != "$engine" ]; then
    status failed "That is not the latest CONscripter release any more; check again"
    exit 0
  fi
  # Checksums come from main: the deployed source only knows the releases up to its own.
  curl -fsSL -o "$work/sums" "https://raw.githubusercontent.com/$repo/main/scripts/conscripter/sha256sums"
  if ! awk -v tag="$engine" '$1 == tag { found = 1 } END { exit !found }' "$work/sums"; then
    status failed "That release has no recorded checksum on main yet; try again later"
    exit 0
  fi
  CONSCRIPTER_TAG=$engine CONSCRIPTER_SUMS=$work/sums CONSCRIPTER_OUT=$work/engine "$APP/scripts/conscripter/build.sh"
  as_owner mkdir -p "$data/state/engine"
  # The version file last, so a half-installed engine is never announced.
  for file in conscripter.js conscripter.wasm conscripter-version.txt; do
    write "$data/state/engine/$file" < "$work/engine/$file"
  done
  status done "Installed"
  exit 0
else
  # Only the head of main (bleeding edge) or the latest release (stable): GitHub
  # also serves commits pushed to forks under this repository's name, and the
  # request file is writable from the containers.
  sha() { curl -fsSL -H 'Accept: application/vnd.github.sha' "https://api.github.com/repos/$repo/commits/$1"; }
  tag=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" \
    | sed -n 's/^ *"tag_name": *"\([A-Za-z0-9._-]*\)".*/\1/p' || true)
  version=${ref:0:8}
  head=$(sha main)
  if [ -n "$tag" ] && [[ "$head" != "$ref"* ]]; then
    head=$(sha "$tag")
    version=$tag-0-g${ref:0:8}
  fi
  if [[ ! "$head" =~ ^[0-9a-f]{40}$ ]] || [[ "$head" != "$ref"* ]]; then
    status failed "That commit is neither the newest on main nor the latest release any more; check again"
    exit 0
  fi
  mkdir "$work/src"
  curl -fsSL "https://codeload.github.com/$repo/tar.gz/$head" | tar -xz -C "$work/src" --strip-components=1
fi

status running "Building"
images=$($compose config --images | sort -u)
for image in $images; do
  docker image tag "$image" "${image%:*}:previous" 2>/dev/null || true
done
# Puts back the source and the images that ran (so the next update keeps them as :previous).
restore() {
  for image in $images; do
    docker image tag "${image%:*}:previous" "$image" 2>/dev/null || true
  done
  rm -rf "$APP"
  mv "$APP.previous" "$APP"
}
rm -rf "$APP.previous"
mv "$APP" "$APP.previous"
mv "$work/src" "$APP"
export VERSION=${version:-docker}
if ! $compose build --quiet; then
  restore
  status failed "The new version did not build; the running one stays"
  exit 1
fi

status running "Restarting"
if ! $compose up -d --remove-orphans; then
  restore
  $compose up -d --remove-orphans || true
  status failed "The new version did not start; the previous one runs again"
  exit 1
fi
# Fill library.db's books, then copy the sync folders in (idempotent; the folders stay as they are).
{
  $compose run --rm --no-deps -T catalog build-calibre-catalog /library /data/state/catalog/catalog.json \
    && $compose run --rm --no-deps -T api python3 /app/api/migrate.py --apply
} || echo "Migration to the API database failed; the old sync folders are untouched" >&2
docker image prune -f >/dev/null
rm -rf "$APP.previous"
for command in $COMMANDS; do
  install -m 755 "$APP/deploy/server/$command" "/usr/local/bin/$command"
done
status done "Updated"
