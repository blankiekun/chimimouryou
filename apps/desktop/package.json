{
  "name": "desktop",
  "productName": "chimimouryou",
  "version": "0.0.1",
  "description": "chimimouryou's standalone reader as a desktop app, with Yomitan",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "fetch": "node node_modules/electron/install.js && bash scripts/fetch-yomitan.sh && bash scripts/fetch-lunahook.sh",
    "build:web": "cd ../web && VITE_EDITION=standalone VITE_STORAGE_ROOT_NAME=chimi-reader-data pnpm build",
    "start": "electron .",
    "test": "node --test serve.test.js oauth.test.js version.test.js games.test.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.blankiekun.chimimouryou",
    "files": [
      "main.js",
      "games.js",
      "game-media.js",
      "overlay.js",
      "oauth.js",
      "preload.cjs",
      "serve.js",
      "updater.js",
      "version.js",
      "yomitan-shim.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/build",
        "to": "web"
      },
      {
        "from": "yomitan",
        "to": "yomitan"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "executableName": "chimimouryou",
      "extraResources": [
        {
          "from": "lunahook",
          "to": "lunahook"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "lunahook",
          "to": "lunahook"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "blankiekun",
      "repo": "chimimouryou"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
