{
  "name": "Chimimouryou",
  "short_name": "Chimimouryou",
  "theme_color": "#0F7A5C",
  "background_color": "#FFFFFF",
  "display": "standalone",
  "scope": "./",
  "start_url": "./",
  "launch_handler": { "client_mode": "navigate-existing" },
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "books",
          "accept": [".epub", ".htmlz", ".cbz", ".zip", "application/epub+zip", "application/zip"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./manage",
      "accept": {
        "application/epub+zip": [".epub"],
        "application/zip": [".htmlz", ".zip"],
        "application/vnd.comicbook+zip": [".cbz"]
      }
    }
  ],
  "icons": [
    {
      "src": "icons/regular-icon@16x16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon@16x16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/regular-icon@32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon@32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon@128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/regular-icon@192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon@192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/regular-icon@512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon@512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
